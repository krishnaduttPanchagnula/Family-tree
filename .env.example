# Optional configuration for `docker compose up` (copy to `.env`).
# All values are optional — leave them out unless you use the feature.

# Host port the app is published on (container always listens on 8099)
PORT=8099

# Google Drive photo storage
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AWS S3 photo storage
AWS_BUCKET_NAME=
AWS_REGION=

# Repository the in-app update checker polls (owner/repo, https://... or git@...).
# Defaults to krishnaduttPanchagnula/Family-tree — only set this to check a fork.
# FAMILYTREE_RELEASE_REPOSITORY=your-name/Family-tree
